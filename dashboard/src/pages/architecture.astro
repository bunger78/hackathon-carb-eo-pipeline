---
import Base from '../layouts/Base.astro';
---

<Base title="CarbLegal — Architecture">
  <h1>Architecture</h1>
  <p class="section-note">
    Daily batch pipeline: an ADK 2 workflow graph drives extraction against Gemini, a Vertex batch job backfills
    historical PDFs, and everything lands in one Firestore that this dashboard reads.
  </p>

  <div class="arch-viewport">
    <svg viewBox="0 0 1100 100" width="100%" height="auto" preserveAspectRatio="xMidYMid meet" role="img"
      aria-label="Cloud Scheduler triggers Cloud Run carb-api at 6:00 AM daily, or an admin can trigger it manually.">
      <defs>
        <marker id="tarrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--text-muted)"></path>
        </marker>
      </defs>
      <line x1="340" y1="50" x2="755" y2="50" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#tarrow)"></line>
      <text x="547" y="40" text-anchor="middle" class="caption">+ manual / admin</text>
      <g>
        <rect x="60" y="25" width="280" height="50" rx="8" fill="var(--surface-2)" stroke="var(--text-muted)" stroke-width="1"></rect>
        <text x="200" y="46" text-anchor="middle" class="a-text" fill="var(--text)">Cloud Scheduler</text>
        <text x="200" y="64" text-anchor="middle" class="node-sub">6:00 AM daily</text>
      </g>
      <g>
        <rect x="760" y="25" width="280" height="50" rx="8" fill="var(--surface-2)" stroke="var(--text-muted)" stroke-width="1"></rect>
        <text x="900" y="46" text-anchor="middle" class="a-text" fill="var(--text)">Cloud Run carb-api</text>
        <text x="900" y="64" text-anchor="middle" class="node-sub">/run</text>
      </g>
    </svg>
  </div>

  <h2>The decision logic (every run)</h2>

  <div class="arch-viewport">
    <svg
      viewBox="0 0 1100 2780"
      width="100%"
      height="auto"
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label="Decision flowchart: on wake, check failed work from last time (transient errors requeue via heal, corrupt source files re-download via refetch, three-strike items park for a human); then check for new EOs (scout downloads and enqueues them); then loop while there is queued work and time/budget remain (claim takes the oldest item); for each item, extract with a native-PDF to rendered-image fallback ladder, run a deterministic audit gate plus a Gemini critic with human-review fallback, resolve ambiguous vehicle matches, mark superseded predecessors, write matches, and loop back to claim the next item; when the queue empties or the run runs out of time or budget, write the run summary and sleep until tomorrow."
    >
      <title>CarbLegal decision flowchart</title>
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--text-muted)"></path>
        </marker>
        <marker id="arrow-green" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--status-complete)"></path>
        </marker>
        <marker id="arrow-red" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--status-failed)"></path>
        </marker>
      </defs>

      <!-- ============ START ============ -->
      <rect x="370" y="20" width="260" height="44" rx="22" fill="var(--surface-2)" stroke="var(--accent)" stroke-width="1.5"></rect>
      <text x="500" y="47" text-anchor="middle" class="a-text" fill="var(--accent)">6:00 AM — Scheduler rings</text>
      <line x1="500" y1="64" x2="500" y2="110" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>

      <!-- ============ STEP 2: failed work? ============ -->
      <polygon points="500,110 670,180 500,250 330,180" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="500" y="175" text-anchor="middle" class="q-text">failed work from</text>
      <text x="500" y="193" text-anchor="middle" class="q-text">last time?</text>

      <path d="M330,180 L60,180 L60,650 L500,650" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <text x="65" y="172" text-anchor="start" class="no-label">no</text>
      <line x1="500" y1="250" x2="500" y2="310" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="514" y="285" text-anchor="start" class="yes-label">yes</text>

      <!-- why did it fail? -->
      <polygon points="500,310 640,375 500,440 360,375" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="500" y="371" text-anchor="middle" class="q-text">why did</text>
      <text x="500" y="389" text-anchor="middle" class="q-text">it fail?</text>

      <path d="M360,375 L150,495" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <line x1="500" y1="440" x2="500" y2="495" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <path d="M640,375 L850,495" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>

      <rect x="20" y="495" width="260" height="50" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="150" y="517" text-anchor="middle" class="a-text">quota blip →</text>
      <text x="150" y="534" text-anchor="middle" class="a-text">requeue</text>
      <text x="290" y="524" text-anchor="start" class="tag">(heal)</text>

      <rect x="310" y="495" width="380" height="50" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="500" y="517" text-anchor="middle" class="a-text">bad file → re-download from CARB,</text>
      <text x="500" y="534" text-anchor="middle" class="a-text">requeue</text>
      <text x="700" y="524" text-anchor="start" class="tag">(refetch)</text>

      <rect x="720" y="495" width="260" height="50" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="850" y="517" text-anchor="middle" class="a-text">3rd strike → leave</text>
      <text x="850" y="534" text-anchor="middle" class="a-text">for a human</text>

      <path d="M150,545 L500,650" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <path d="M500,545 L500,650" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <path d="M850,545 L500,650" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>

      <!-- ============ STEP 3: new EOs? ============ -->
      <polygon points="500,650 670,720 500,790 330,720" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="500" y="715" text-anchor="middle" class="q-text">new EOs in the</text>
      <text x="500" y="733" text-anchor="middle" class="q-text">state registry?</text>

      <line x1="670" y1="720" x2="700" y2="720" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="678" y="705" text-anchor="start" class="yes-label">yes</text>
      <rect x="700" y="693" width="300" height="54" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="850" y="714" text-anchor="middle" class="a-text">download PDFs,</text>
      <text x="850" y="731" text-anchor="middle" class="a-text">add to queue</text>
      <text x="1010" y="723" text-anchor="start" class="tag">(scout)</text>

      <path d="M850,747 L500,870" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <line x1="500" y1="790" x2="500" y2="870" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="464" y="820" text-anchor="end" class="step-label">both</text>

      <!-- ============ STEP 4: work in queue? time/budget left? ============ -->
      <polygon points="500,870 670,940 500,1010 330,940" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="500" y="925" text-anchor="middle" class="q-text">work in queue?</text>
      <text x="500" y="943" text-anchor="middle" class="q-text">time &amp; budget left?</text>

      <path d="M330,940 L150,940 L150,990" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <text x="200" y="932" text-anchor="middle" class="no-label">no</text>
      <rect x="20" y="990" width="300" height="60" rx="10" fill="var(--status-complete-bg)" stroke="var(--accent)" stroke-width="1.5"></rect>
      <text x="170" y="1014" text-anchor="middle" class="a-text">write run summary —</text>
      <text x="170" y="1031" text-anchor="middle" class="a-text">sleep until tomorrow</text>
      <text x="330" y="1023" text-anchor="start" class="tag">(summarize)</text>

      <line x1="500" y1="1010" x2="500" y2="1070" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="514" y="1044" text-anchor="start" class="yes-label">yes</text>
      <rect x="360" y="1070" width="280" height="54" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="500" y="1103" text-anchor="middle" class="a-text">claim oldest item</text>
      <text x="650" y="1103" text-anchor="start" class="tag">(claim)</text>

      <line x1="500" y1="1124" x2="500" y2="1194" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="700" y="1180" text-anchor="middle" class="tag">(process) — per claimed item, steps below</text>

      <!-- ============ STEP 5: Gemini read PDF natively? ============ -->
      <polygon points="500,1194 670,1264 500,1334 330,1264" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="500" y="1259" text-anchor="middle" class="q-text">can Gemini read the</text>
      <text x="500" y="1277" text-anchor="middle" class="q-text">PDF natively?</text>

      <line x1="330" y1="1264" x2="320" y2="1264" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="200" y="1249" text-anchor="middle" class="no-label">no</text>
      <rect x="20" y="1237" width="300" height="54" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="170" y="1258" text-anchor="middle" class="a-text">re-render pages as</text>
      <text x="170" y="1275" text-anchor="middle" class="a-text">images, retry</text>

      <line x1="170" y1="1291" x2="170" y2="1341" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <polygon points="170,1341 310,1406 170,1471 30,1406" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="170" y="1411" text-anchor="middle" class="q-text">readable now?</text>

      <line x1="170" y1="1471" x2="170" y2="1521" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="200" y="1500" text-anchor="middle" class="no-label">no</text>
      <rect x="20" y="1521" width="300" height="60" rx="10" fill="var(--status-failed-bg)" stroke="var(--status-failed)" stroke-width="1.5"></rect>
      <text x="170" y="1545" text-anchor="middle" class="a-text">mark failed — tomorrow's</text>
      <text x="170" y="1562" text-anchor="middle" class="a-text">run decides</text>

      <path d="M310,1406 L500,1611" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <text x="330" y="1395" text-anchor="start" class="yes-label">yes</text>
      <line x1="500" y1="1334" x2="500" y2="1611" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="514" y="1360" text-anchor="start" class="yes-label">yes</text>

      <!-- ============ STEP 6: extraction ============ -->
      <rect x="320" y="1611" width="360" height="54" rx="10" fill="var(--surface-2)" stroke="var(--status-matching)" stroke-width="1.5"></rect>
      <text x="500" y="1644" text-anchor="middle" class="a-text">structured extraction (Gemini 3.7 Flash)</text>
      <line x1="500" y1="1665" x2="500" y2="1735" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>

      <!-- ============ STEP 7: header EO matches identity? ============ -->
      <polygon points="500,1735 670,1805 500,1875 330,1805" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="500" y="1800" text-anchor="middle" class="q-text">header EO number matches</text>
      <text x="500" y="1818" text-anchor="middle" class="q-text">the file's identity?</text>

      <line x1="330" y1="1805" x2="310" y2="1805" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="200" y="1790" text-anchor="middle" class="no-label">no</text>
      <rect x="30" y="1781" width="280" height="48" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="170" y="1800" text-anchor="middle" class="a-text">trust the file,</text>
      <text x="170" y="1817" text-anchor="middle" class="a-text">log the misread</text>

      <path d="M170,1829 L500,1935" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <line x1="500" y1="1875" x2="500" y2="1935" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="514" y="1905" text-anchor="start" class="yes-label">yes</text>

      <!-- ============ STEP 8: deterministic gate + critic ============ -->
      <polygon points="500,1935 690,2020 500,2105 310,2020" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="500" y="2000" text-anchor="middle" class="q-text">deterministic gate:</text>
      <text x="500" y="2018" text-anchor="middle" class="q-text">rules + baseline</text>
      <text x="500" y="2036" text-anchor="middle" class="q-text-sm">(dates real · formats sane ·</text>
      <text x="500" y="2050" text-anchor="middle" class="q-text-sm">physics possible · vs. legacy)</text>
      <text x="650" y="2020" text-anchor="start" class="tag">(audit)</text>

      <line x1="310" y1="2020" x2="290" y2="2020" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="200" y="2005" text-anchor="middle" class="no-label">fail</text>
      <rect x="10" y="1993" width="280" height="54" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="150" y="2014" text-anchor="middle" class="a-text">critic re-reads the</text>
      <text x="150" y="2031" text-anchor="middle" class="a-text">document (Gemini)</text>

      <line x1="150" y1="2047" x2="150" y2="2097" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <polygon points="150,2097 290,2162 150,2227 10,2162" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="150" y="2168" text-anchor="middle" class="q-text">resolved?</text>

      <path d="M150,2227 L220,2277" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <text x="170" y="2260" text-anchor="middle" class="no-label">no</text>
      <rect x="30" y="2277" width="380" height="80" rx="10" fill="var(--status-needs_review-bg)" stroke="var(--status-needs_review)" stroke-width="1.5"></rect>
      <text x="220" y="2303" text-anchor="middle" class="a-text">human review queue (via carb-dash)</text>
      <text x="220" y="2320" text-anchor="middle" class="a-text">→ approve / correct</text>
      <text x="220" y="2337" text-anchor="middle" class="a-text">→ re-match</text>

      <path d="M290,2162 L500,2280" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <text x="320" y="2150" text-anchor="start" class="yes-label">yes</text>
      <line x1="500" y1="2105" x2="500" y2="2280" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="514" y="2145" text-anchor="start" class="yes-label">pass</text>

      <!-- ============ STEP 9: ambiguous vehicle rows? ============ -->
      <polygon points="500,2280 670,2350 500,2420 330,2350" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="500" y="2345" text-anchor="middle" class="q-text">any ambiguous</text>
      <text x="500" y="2363" text-anchor="middle" class="q-text">vehicle rows?</text>

      <line x1="670" y1="2350" x2="700" y2="2350" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="678" y="2335" text-anchor="start" class="yes-label">yes</text>
      <rect x="700" y="2320" width="220" height="60" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="810" y="2344" text-anchor="middle" class="a-text">Gemini resolves →</text>
      <text x="810" y="2361" text-anchor="middle" class="a-text">fake IDs filtered</text>

      <path d="M810,2380 L500,2470" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <line x1="500" y1="2420" x2="500" y2="2470" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="464" y="2450" text-anchor="end" class="no-label">no</text>

      <!-- ============ STEP 10: supersedes and cancels? ============ -->
      <polygon points="500,2470 670,2540 500,2610 330,2540" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="2"></polygon>
      <text x="500" y="2535" text-anchor="middle" class="q-text">document says</text>
      <text x="500" y="2553" text-anchor="middle" class="q-text">"supersedes and cancels"?</text>

      <line x1="670" y1="2540" x2="700" y2="2540" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="678" y="2525" text-anchor="start" class="yes-label">yes</text>
      <rect x="700" y="2510" width="220" height="60" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="810" y="2534" text-anchor="middle" class="a-text">mark old EO superseded</text>
      <text x="810" y="2551" text-anchor="middle" class="a-text">— link the chain</text>

      <path d="M810,2570 L500,2660" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <line x1="500" y1="2610" x2="500" y2="2660" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <text x="464" y="2640" text-anchor="end" class="no-label">no</text>

      <!-- ============ STEP 11: write matches + loop back ============ -->
      <rect x="320" y="2660" width="360" height="54" rx="10" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
      <text x="500" y="2693" text-anchor="middle" class="a-text">write part-to-vehicle matches</text>

      <path d="M680,2687 L980,2687 L980,940 L670,940" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <text x="990" y="960" text-anchor="start" class="step-label">next item</text>
    </svg>
  </div>

  <p class="section-note">
    Runs on: Cloud Run · Firestore (leased work queue = the checkpoint) · GCS · Vertex AI. Historical bulk
    backfill used Vertex batch pricing through the same gate.
  </p>

  <p class="section-note">The gate logic mirrors pipeline/workflow_graph.py and agents/* — node names tagged in (parens); verified by test.</p>
</Base>

<style>
  .arch-viewport {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 1.5rem clamp(1rem, 4vw, 4rem) 0.5rem;
    box-sizing: border-box;
  }

  .arch-viewport svg {
    display: block;
    width: 100%;
    max-width: 900px;
    height: auto;
    margin: 0 auto;
  }

  h2 {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .arch-viewport :global(.q-text) {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    fill: var(--text);
  }

  .arch-viewport :global(.q-text-sm) {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    fill: var(--text-muted);
  }

  .arch-viewport :global(.a-text) {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    fill: var(--text);
  }

  .arch-viewport :global(.node-sub) {
    font-family: var(--font-sans);
    font-size: 14px;
    fill: var(--text-muted);
  }

  .arch-viewport :global(.tag) {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    fill: var(--text-muted);
  }

  .arch-viewport :global(.yes-label) {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    fill: var(--status-complete);
    stroke: var(--bg);
    stroke-width: 5;
    paint-order: stroke;
    stroke-linejoin: round;
  }

  .arch-viewport :global(.no-label) {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    fill: var(--status-failed);
    stroke: var(--bg);
    stroke-width: 5;
    paint-order: stroke;
    stroke-linejoin: round;
  }

  .arch-viewport :global(.step-label) {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    fill: var(--text-muted);
    stroke: var(--bg);
    stroke-width: 5;
    paint-order: stroke;
    stroke-linejoin: round;
  }

