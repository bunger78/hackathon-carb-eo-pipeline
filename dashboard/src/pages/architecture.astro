---
import Base from '../layouts/Base.astro';
---

<Base title="CarbLegal — Architecture">
  <h1>Architecture</h1>
  <p class="section-note">
    Daily batch pipeline: an ADK 2 workflow graph drives extraction against Gemini, a Vertex batch job backfills
    historical PDFs, and everything lands in one Firestore that this dashboard reads.
  </p>

  <div class="arch-viewport">
    <svg
      viewBox="0 0 1600 1100"
      width="100%"
      height="auto"
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label="CarbLegal architecture: Cloud Scheduler triggers carb-api, which runs the ADK 2 workflow graph -- scout, heal, refetch, claim, process, summarize. Claim routes to process (item) or summarize (empty / time-cap); process routes back to claim (loop) or to summarize (budget). Process expands into extract, audit, and match, all backed by Gemini 3.7 Flash; audit's escalate route feeds a human review loop whose corrections flow back into match. A Vertex batch backfill path runs alongside. Everything persists to Firestore and GCS, read by carb-dash."
    >
      <title>CarbLegal architecture diagram</title>
      <defs>
        <filter id="glow" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="blur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
        <marker id="arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--text-muted)"></path>
        </marker>
        <marker id="arrow-violet" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--status-matching)"></path>
        </marker>
        <marker id="arrow-muted" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--text-muted)" opacity="0.6"></path>
        </marker>
        <marker id="arrow-amber" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--status-needs_review)"></path>
        </marker>
      </defs>

      <!-- ================= BAND BACKGROUNDS ================= -->
      <rect x="0" y="0" width="1600" height="110" fill="var(--surface)" opacity="0.4"></rect>
      <rect x="0" y="110" width="1600" height="560" fill="var(--bg)"></rect>
      <rect x="0" y="670" width="1600" height="150" fill="var(--surface)" opacity="0.4"></rect>
      <rect x="0" y="820" width="1600" height="280" fill="var(--bg)"></rect>
      <line x1="0" y1="110" x2="1600" y2="110" stroke="var(--border)" stroke-width="1"></line>
      <line x1="0" y1="670" x2="1600" y2="670" stroke="var(--border)" stroke-width="1"></line>
      <line x1="0" y1="820" x2="1600" y2="820" stroke="var(--border)" stroke-width="1"></line>

      <!-- ================= BAND LABELS ================= -->
      <text x="60" y="32" class="band-label">TRIGGER</text>
      <text x="60" y="132" class="band-label">ORCHESTRATION</text>
      <text x="60" y="692" class="band-label">PERSISTENCE</text>
      <text x="60" y="842" class="band-label">SURFACE</text>

      <!-- ================= ORCHESTRATION FRAME ================= -->
      <rect x="40" y="142" width="920" height="500" rx="16" fill="var(--surface)" opacity="0.4" stroke="var(--border-strong)" stroke-width="1.5"></rect>
      <text x="500" y="170" text-anchor="middle" class="frame-label">ADK 2 GRAPH — GOOGLE.ADK.WORKFLOW</text>

      <!-- ================= BATCH LANE BOX (right side, subtle) ================= -->
      <rect x="980" y="155" width="560" height="345" rx="14" fill="var(--surface-2)" opacity="0.25" stroke="var(--border)" stroke-width="1" stroke-dasharray="4,4"></rect>
      <text x="1005" y="182" class="band-label" opacity="0.75">BATCH PATH</text>

      <!-- ================= EDGES (drawn under nodes) ================= -->

      <!-- trigger -->
      <line x1="350" y1="72" x2="405" y2="72" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <path d="M540,96 L540,115 L125,115 L125,215" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>

      <!-- main row: scout -> heal -> refetch -> claim -> process ("item") -->
      <line x1="180" y1="245" x2="206" y2="245" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <line x1="306" y1="245" x2="332" y2="245" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <line x1="452" y1="245" x2="478" y2="245" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <line x1="578" y1="245" x2="604" y2="245" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>

      <!-- claim/process route arcs -->
      <path d="M624,220 Q591,185 558,220" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <path d="M704,220 Q737,185 770,220" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>
      <path d="M528,270 Q664,312 820,270" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>

      <!-- process (extract->audit->match) internal chain -->
      <line x1="270" y1="395" x2="290" y2="395" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <line x1="475" y1="395" x2="495" y2="395" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>

      <!-- extract/audit/match -> gemini (dashed), each its own per-call edge, gemini on the right so none of these cross the escalate path -->
      <path d="M178,420 L178,470 L765,470" fill="none" stroke="var(--status-matching)" stroke-width="2" stroke-dasharray="6,5" marker-end="url(#arrow-violet)"></path>
      <path d="M383,420 L383,486 L765,486" fill="none" stroke="var(--status-matching)" stroke-width="2" stroke-dasharray="6,5" marker-end="url(#arrow-violet)"></path>
      <path d="M588,420 L588,502 L765,502" fill="none" stroke="var(--status-matching)" stroke-width="2" stroke-dasharray="6,5" marker-end="url(#arrow-violet)"></path>
      <text x="220" y="464" text-anchor="middle" class="edge-label">read</text>
      <text x="425" y="480" text-anchor="middle" class="edge-label">critique</text>
      <text x="630" y="496" text-anchor="middle" class="edge-label">resolve</text>

      <!-- human review loop: audit's bottom edge "escalate" -> review queue (bottom-left) -> human (bottom-right) -> "approve/corrections" -> match's bottom-left corner, routed under the content to clear the gemini "resolve" edge -->
      <path d="M350,420 Q260,490 172,555" fill="none" stroke="var(--status-needs_review)" stroke-width="2" marker-end="url(#arrow-amber)"></path>
      <line x1="260" y1="579" x2="520" y2="579" stroke="var(--status-needs_review)" stroke-width="2" marker-end="url(#arrow-amber)"></line>
      <path d="M535,603 L535,612 L510,612 L510,420" fill="none" stroke="var(--status-needs_review)" stroke-width="2" marker-end="url(#arrow-amber)"></path>
      <text x="280" y="478" text-anchor="middle" class="edge-label">escalate</text>
      <text x="495" y="516" text-anchor="end" class="edge-label">approve / corrections</text>

      <!-- down into persistence -->
      <line x1="200" y1="642" x2="200" y2="705" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <line x1="850" y1="642" x2="850" y2="705" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <path d="M125,642 L125,662 L1260,662 L1260,705" fill="none" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></path>

      <!-- batch lane, subtle -->
      <line x1="1260" y1="705" x2="1260" y2="383" stroke="var(--text-muted)" stroke-width="1.5" opacity="0.65" marker-end="url(#arrow-muted)"></line>
      <line x1="1260" y1="330" x2="1260" y2="263" stroke="var(--text-muted)" stroke-width="1.5" opacity="0.65" marker-end="url(#arrow-muted)"></line>
      <path d="M1185,234 L1030,234 L1030,650 L1015,650 L1015,705" fill="none" stroke="var(--text-muted)" stroke-width="1.5" opacity="0.65" marker-end="url(#arrow-muted)"></path>

      <!-- surface -->
      <line x1="555" y1="805" x2="555" y2="885" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
      <path d="M680,920 L1580,920 L1580,72 L675,72" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-dasharray="6,4" marker-end="url(#arrow)"></path>

      <!-- ================= EDGE LABELS (halo text, on top of lines) ================= -->
      <text x="1130" y="912" text-anchor="middle" class="edge-label">admin</text>
      <text x="572" y="825" text-anchor="start" class="edge-label">reads</text>

      <!-- ================= TRIGGER NODES ================= -->
      <g filter="url(#glow)">
        <rect x="90" y="48" width="260" height="48" rx="10" fill="var(--surface-2)" stroke="var(--text-muted)" stroke-width="1"></rect>
        <text x="220" y="68" text-anchor="middle" class="node-title" fill="var(--text)">Cloud Scheduler</text>
        <text x="220" y="86" text-anchor="middle" class="node-sub">6:00 AM daily</text>
      </g>
      <g filter="url(#glow)">
        <rect x="410" y="48" width="260" height="48" rx="10" fill="var(--surface-2)" stroke="var(--text-muted)" stroke-width="1"></rect>
        <text x="540" y="68" text-anchor="middle" class="node-title" fill="var(--text)">Cloud Run carb-api</text>
        <text x="540" y="86" text-anchor="middle" class="node-sub">/run</text>
      </g>

      <!-- ================= ADK2 MAIN ROW ================= -->
      <g filter="url(#glow)">
        <rect x="70" y="220" width="110" height="50" rx="10" fill="var(--surface-2)" stroke="var(--status-discovered)" stroke-width="1"></rect>
        <text x="125" y="239" text-anchor="middle" class="node-title" fill="var(--status-discovered)">scout</text>
        <text x="125" y="259" text-anchor="middle" class="node-sub">discover EOs</text>
      </g>
      <g filter="url(#glow)">
        <rect x="206" y="220" width="100" height="50" rx="10" fill="var(--surface-2)" stroke="var(--agent-healer)" stroke-width="1"></rect>
        <text x="256" y="239" text-anchor="middle" class="node-title" fill="var(--agent-healer)">heal</text>
        <text x="256" y="259" text-anchor="middle" class="node-sub">requeue transient</text>
      </g>
      <g filter="url(#glow)">
        <rect x="332" y="220" width="120" height="50" rx="10" fill="var(--surface-2)" stroke="var(--agent-healer)" stroke-width="1"></rect>
        <text x="392" y="239" text-anchor="middle" class="node-title" fill="var(--agent-healer)">refetch</text>
        <text x="392" y="259" text-anchor="middle" class="node-sub">re-download source</text>
      </g>
      <g filter="url(#glow)">
        <rect x="478" y="220" width="100" height="50" rx="10" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="1"></rect>
        <text x="528" y="239" text-anchor="middle" class="node-title" fill="var(--status-needs_review)">claim</text>
        <text x="528" y="259" text-anchor="middle" class="node-sub">next item</text>
      </g>
      <g filter="url(#glow)">
        <rect x="604" y="220" width="120" height="50" rx="10" fill="var(--surface-2)" stroke="var(--status-matching)" stroke-width="1"></rect>
        <text x="664" y="239" text-anchor="middle" class="node-title" fill="var(--status-matching)">process</text>
        <text x="664" y="259" text-anchor="middle" class="node-sub">per-EO (below)</text>
      </g>
      <g filter="url(#glow)">
        <rect x="750" y="220" width="140" height="50" rx="10" fill="var(--surface-2)" stroke="var(--accent)" stroke-width="1"></rect>
        <text x="820" y="239" text-anchor="middle" class="node-title" fill="var(--accent)">summarize</text>
        <text x="820" y="259" text-anchor="middle" class="node-sub">finish run</text>
      </g>

      <!-- ================= TOP ROW ROUTE LABELS (dark chip behind each, on its arrow's midpoint, drawn after the nodes so it's never clipped) ================= -->
      <rect x="567" y="236" width="48" height="18" rx="4" fill="var(--bg)"></rect>
      <text x="591" y="249" text-anchor="middle" class="edge-label">item</text>
      <rect x="567" y="192" width="48" height="18" rx="4" fill="var(--bg)"></rect>
      <text x="591" y="205" text-anchor="middle" class="edge-label">loop</text>
      <rect x="707" y="192" width="60" height="18" rx="4" fill="var(--bg)"></rect>
      <text x="737" y="205" text-anchor="middle" class="edge-label">budget</text>
      <rect x="596" y="283" width="136" height="18" rx="4" fill="var(--bg)"></rect>
      <text x="664" y="296" text-anchor="middle" class="edge-label">empty · time-cap</text>

      <!-- ================= HEALER CAPTION ================= -->
      <text x="329" y="286" text-anchor="middle" class="caption">transient -&gt; requeue · corrupt source -&gt; re-download · 3 strikes -&gt; human</text>

      <!-- ================= PROCESS (PER EO) SUB-FRAME ================= -->
      <rect x="55" y="325" width="890" height="300" rx="14" fill="var(--surface-2)" opacity="0.35" stroke="var(--status-matching)" stroke-width="1.5"></rect>
      <text x="500" y="350" text-anchor="middle" class="frame-label">PROCESS (PER EO)</text>

      <g filter="url(#glow)">
        <rect x="85" y="370" width="185" height="50" rx="10" fill="var(--surface-2)" stroke="var(--status-discovered)" stroke-width="1"></rect>
        <text x="178" y="389" text-anchor="middle" class="node-title" fill="var(--status-discovered)">extract</text>
        <text x="178" y="409" text-anchor="middle" class="node-sub">PDF -&gt; image ladder</text>
      </g>
      <g filter="url(#glow)">
        <rect x="290" y="370" width="185" height="50" rx="10" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="1"></rect>
        <text x="383" y="389" text-anchor="middle" class="node-title" fill="var(--status-needs_review)">audit</text>
        <text x="383" y="409" text-anchor="middle" class="node-sub">gate + critic</text>
      </g>
      <g filter="url(#glow)">
        <rect x="495" y="370" width="185" height="50" rx="10" fill="var(--surface-2)" stroke="var(--status-complete)" stroke-width="1"></rect>
        <text x="588" y="389" text-anchor="middle" class="node-title" fill="var(--status-complete)">match</text>
        <text x="588" y="409" text-anchor="middle" class="node-sub">index + resolver</text>
      </g>

      <!-- ================= GEMINI CHIP (violet glow) — right side of the process frame, vertically centered, one edge per call ================= -->
      <g filter="url(#glow)">
        <rect x="765" y="451" width="170" height="70" rx="10" fill="var(--surface-2)" stroke="var(--status-matching)" stroke-width="1.5"></rect>
        <text x="850" y="475" text-anchor="middle" class="node-title" fill="var(--status-matching)">Gemini 3.7 Flash</text>
        <text x="850" y="497" text-anchor="middle" class="node-sub">reasoning calls</text>
      </g>

      <!-- ================= HUMAN REVIEW LOOP ================= -->
      <g filter="url(#glow)">
        <rect x="85" y="555" width="175" height="48" rx="10" fill="var(--surface-2)" stroke="var(--status-needs_review)" stroke-width="1"></rect>
        <text x="172" y="574" text-anchor="middle" class="node-title" fill="var(--status-needs_review)">review queue</text>
        <text x="172" y="592" text-anchor="middle" class="node-sub">audit escalations</text>
      </g>
      <g filter="url(#glow)">
        <rect x="520" y="555" width="160" height="48" rx="10" fill="var(--surface-2)" stroke="var(--text-muted)" stroke-width="1"></rect>
        <text x="600" y="574" text-anchor="middle" class="node-title" fill="var(--text)">human</text>
        <text x="600" y="592" text-anchor="middle" class="node-sub">manual review</text>
      </g>

      <!-- ================= BATCH LANE NODES (subtle) ================= -->
      <g opacity="0.85">
        <rect x="1185" y="330" width="150" height="48" rx="8" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
        <text x="1260" y="350" text-anchor="middle" class="node-title-sm" fill="var(--text-muted)">Vertex AI batch job</text>
        <text x="1260" y="367" text-anchor="middle" class="node-sub">batch inference</text>
      </g>
      <g opacity="0.85">
        <rect x="1185" y="210" width="150" height="48" rx="8" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></rect>
        <text x="1260" y="230" text-anchor="middle" class="node-title-sm" fill="var(--text-muted)">batchfill --ingest</text>
        <text x="1260" y="247" text-anchor="middle" class="node-sub">backfill CLI</text>
      </g>

      <!-- ================= PERSISTENCE CYLINDERS ================= -->
      <!-- Firestore -->
      <ellipse cx="555" cy="784" rx="465" ry="16" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></ellipse>
      <rect x="90" y="726" width="930" height="58" fill="var(--surface-2)"></rect>
      <line x1="90" y1="726" x2="90" y2="784" stroke="var(--border-strong)" stroke-width="1"></line>
      <line x1="1020" y1="726" x2="1020" y2="784" stroke="var(--border-strong)" stroke-width="1"></line>
      <ellipse cx="555" cy="726" rx="465" ry="16" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></ellipse>
      <text x="555" y="750" text-anchor="middle" class="node-title" fill="var(--text)">Firestore</text>
      <text x="555" y="769" text-anchor="middle" class="node-sub">eos · work_items · runs · matches · review_queue</text>

      <!-- GCS -->
      <ellipse cx="1260" cy="784" rx="100" ry="16" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></ellipse>
      <rect x="1160" y="726" width="200" height="58" fill="var(--surface-2)"></rect>
      <line x1="1160" y1="726" x2="1160" y2="784" stroke="var(--border-strong)" stroke-width="1"></line>
      <line x1="1360" y1="726" x2="1360" y2="784" stroke="var(--border-strong)" stroke-width="1"></line>
      <ellipse cx="1260" cy="726" rx="100" ry="16" fill="var(--surface-2)" stroke="var(--border-strong)" stroke-width="1"></ellipse>
      <text x="1260" y="750" text-anchor="middle" class="node-title" fill="var(--text)">GCS bucket</text>
      <text x="1260" y="769" text-anchor="middle" class="node-sub">pdfs/</text>

      <!-- ================= SURFACE ================= -->
      <g filter="url(#glow)">
        <rect x="430" y="890" width="250" height="60" rx="10" fill="var(--surface-2)" stroke="var(--accent)" stroke-width="1"></rect>
        <text x="555" y="914" text-anchor="middle" class="node-title" fill="var(--accent)">carb-dash</text>
        <text x="555" y="934" text-anchor="middle" class="node-sub">reads Firestore live</text>
      </g>
    </svg>
  </div>

  <p class="section-note">Topology mirrors pipeline/workflow_graph.py — verified by test.</p>
</Base>

<style>
  .arch-viewport {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 1.5rem clamp(1rem, 4vw, 4rem) 0.5rem;
    box-sizing: border-box;
  }

  .arch-viewport svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .arch-viewport :global(.band-label) {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    fill: var(--text-muted);
  }

  .arch-viewport :global(.frame-label) {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    fill: var(--text-muted);
  }

  .arch-viewport :global(.node-title) {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
  }

  .arch-viewport :global(.node-title-sm) {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
  }

  .arch-viewport :global(.node-sub) {
    font-family: var(--font-sans);
    font-size: 14px;
    fill: var(--text-muted);
  }

  .arch-viewport :global(.edge-label) {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    fill: var(--text-muted);
    stroke: var(--bg);
    stroke-width: 6;
    paint-order: stroke;
    stroke-linejoin: round;
  }

  .arch-viewport :global(.caption) {
    font-family: var(--font-sans);
    font-size: 13px;
    font-style: italic;
    fill: var(--text-muted);
  }
</style>
