---
import Base from '../layouts/Base.astro';
---

<Base title="CarbLegal — Architecture">
  <h1>Architecture</h1>
  <p class="section-note">
    Daily batch pipeline: an ADK 2 workflow graph drives extraction against Gemini, a Vertex batch job backfills
    historical PDFs, and everything lands in one Firestore that this dashboard reads.
  </p>

  <div class="arch-viewport">
    <svg viewBox="0 0 1100 100" width="100%" height="auto" preserveAspectRatio="xMidYMid meet" role="img"
      aria-label="Cloud Scheduler triggers Cloud Run carb-api at 6:00 AM daily, or an admin can trigger it manually.">
      <defs>
        <filter id="glow-trigger" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="blur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
        <marker id="tarrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--text-muted)"></path>
        </marker>
      </defs>
      <line x1="340" y1="50" x2="755" y2="50" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#tarrow)"></line>
      <text x="547" y="40" text-anchor="middle" class="caption">+ manual / admin</text>
      <g filter="url(#glow-trigger)">
        <rect x="60" y="25" width="280" height="50" rx="10" fill="var(--surface)" stroke="var(--text-muted)" stroke-width="1.5"></rect>
        <text x="200" y="46" text-anchor="middle" class="a-text" fill="var(--text)">Cloud Scheduler</text>
        <text x="200" y="64" text-anchor="middle" class="node-sub">6:00 AM daily</text>
      </g>
      <g filter="url(#glow-trigger)">
        <rect x="760" y="25" width="280" height="50" rx="10" fill="var(--surface)" stroke="var(--text-muted)" stroke-width="1.5"></rect>
        <text x="900" y="46" text-anchor="middle" class="a-text" fill="var(--text)">Cloud Run carb-api</text>
        <text x="900" y="64" text-anchor="middle" class="node-sub">/run</text>
      </g>
    </svg>
  </div>

  <h2>The decision logic (every run)</h2>

  <div class="arch-viewport">
    <svg
      viewBox="0 0 1100 2760"
      width="100%"
      height="auto"
      preserveAspectRatio="xMidYMid meet"
      role="img"
      aria-label="Decision flowchart: on wake, check failed work from last time (transient errors requeue via heal, corrupt source files re-download via refetch, three-strike items park for a human); then check for new EOs (scout downloads and enqueues them); then loop while there is queued work and time/budget remain (claim takes the oldest item); for each item, extract with a native-PDF to rendered-image fallback ladder, run a deterministic audit gate plus a Gemini critic with human-review fallback, resolve ambiguous vehicle matches, mark superseded predecessors, write matches, and loop back to claim the next item; when the queue empties or the run runs out of time or budget, write the run summary and sleep until tomorrow."
    >
      <title>CarbLegal decision flowchart</title>
      <defs>
        <filter id="glow" x="-60%" y="-60%" width="220%" height="220%">
          <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur"></feGaussianBlur>
          <feMerge>
            <feMergeNode in="blur"></feMergeNode>
            <feMergeNode in="SourceGraphic"></feMergeNode>
          </feMerge>
        </filter>
        <marker id="arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--text-muted)"></path>
        </marker>
        <marker id="arrow-green" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--status-complete)"></path>
        </marker>
        <marker id="arrow-red" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--status-failed)"></path>
        </marker>
        <path id="hexgate" d="M -119.3,-11.9 L -95.7,-38.1 Q -85,-50 -69,-50 L 69,-50 Q 85,-50 95.7,-38.1 L 119.3,-11.9 Q 130,0 119.3,11.9 L 95.7,38.1 Q 85,50 69,50 L -69,50 Q -85,50 -95.7,38.1 L -119.3,11.9 Q -130,0 -119.3,-11.9 Z"></path>
      </defs>

      <!-- ================= SECTION BANDS ================= -->
      <rect x="0" y="0" width="1100" height="950" fill="var(--surface)" opacity="0.35"></rect>
      <line x1="0" y1="950" x2="1100" y2="950" stroke="var(--border)" stroke-width="1"></line>
      <rect x="10" y="965" width="1080" height="1756" rx="18" fill="none" stroke="var(--border-strong)" stroke-width="1.5"></rect>
      <rect x="25" y="815" width="290" height="132" rx="14" fill="var(--surface-2)" opacity="0.3" stroke="var(--accent)" stroke-width="1" stroke-dasharray="5,4"></rect>

      <!-- section title chips -->
      <rect x="30" y="18" width="150" height="30" rx="15" fill="var(--surface-2)" stroke="var(--status-discovered)" stroke-width="1.5"></rect>
      <text x="105" y="38" text-anchor="middle" class="band-chip" fill="var(--status-discovered)">WAKE-UP</text>
      <rect x="35" y="803" width="80" height="26" rx="13" fill="var(--surface-2)" stroke="var(--accent)" stroke-width="1.5"></rect>
      <text x="75" y="820" text-anchor="middle" class="band-chip" fill="var(--accent)">REST</text>
      <rect x="30" y="978" width="212" height="30" rx="15" fill="var(--surface-2)" stroke="var(--status-matching)" stroke-width="1.5"></rect>
      <text x="136" y="998" text-anchor="middle" class="band-chip" fill="var(--status-matching)">PER DOCUMENT</text>

      <!-- ================= EDGES (drawn under nodes) ================= -->
      <g fill="none" stroke-linejoin="round" stroke-linecap="round">
        <line x1="500" y1="66" x2="500" y2="146" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>

        <!-- failed-work? -->
        <line x1="500" y1="246" x2="500" y2="326" stroke="var(--status-complete)" stroke-width="2" marker-end="url(#arrow-green)"></line>
        <polyline points="370,196 50,196 50,692 370,692" stroke="var(--status-failed)" stroke-width="2" marker-end="url(#arrow-red)"></polyline>

        <!-- why fail -> 3 branches -->
        <polyline points="430,426 430,466 170,466 170,506" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></polyline>
        <line x1="500" y1="426" x2="500" y2="506" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
        <polyline points="570,426 570,466 850,466 850,506" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></polyline>

        <!-- 3 branches -> new EOs? -->
        <polyline points="170,562 170,602 430,602 430,642" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></polyline>
        <line x1="500" y1="562" x2="500" y2="642" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
        <polyline points="850,562 850,602 570,602 570,642" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></polyline>

        <!-- new EOs? -->
        <line x1="630" y1="692" x2="700" y2="692" stroke="var(--status-complete)" stroke-width="2" marker-end="url(#arrow-green)"></line>
        <polyline points="850,720 850,822 500,822" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></polyline>
        <line x1="500" y1="742" x2="500" y2="822" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>

        <!-- hub: work in queue? -->
        <line x1="370" y1="872" x2="300" y2="872" stroke="var(--status-failed)" stroke-width="2" marker-end="url(#arrow-red)"></line>
        <line x1="500" y1="922" x2="500" y2="1002" stroke="var(--status-complete)" stroke-width="2" marker-end="url(#arrow-green)"></line>
        <line x1="500" y1="1058" x2="500" y2="1138" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>

        <!-- Gemini native read? -->
        <line x1="370" y1="1188" x2="300" y2="1188" stroke="var(--status-failed)" stroke-width="2" marker-end="url(#arrow-red)"></line>
        <line x1="170" y1="1216" x2="170" y2="1296" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
        <line x1="170" y1="1396" x2="170" y2="1476" stroke="var(--status-failed)" stroke-width="2" marker-end="url(#arrow-red)"></line>
        <polyline points="300,1346 500,1346 500,1476" stroke="var(--status-complete)" stroke-width="2" marker-end="url(#arrow-green)"></polyline>
        <line x1="500" y1="1238" x2="500" y2="1476" stroke="var(--status-complete)" stroke-width="2" marker-end="url(#arrow-green)"></line>
        <line x1="500" y1="1532" x2="500" y2="1612" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>

        <!-- header identity check -->
        <line x1="370" y1="1662" x2="300" y2="1662" stroke="var(--status-failed)" stroke-width="2" marker-end="url(#arrow-red)"></line>
        <polyline points="170,1690 170,1792 500,1792" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></polyline>
        <line x1="500" y1="1712" x2="500" y2="1792" stroke="var(--status-complete)" stroke-width="2" marker-end="url(#arrow-green)"></line>

        <!-- deterministic gate -->
        <polyline points="370,1842 170,1842 170,1974" stroke="var(--status-failed)" stroke-width="2" marker-end="url(#arrow-red)"></polyline>
        <line x1="170" y1="2030" x2="170" y2="2110" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></line>
        <line x1="170" y1="2210" x2="170" y2="2290" stroke="var(--status-failed)" stroke-width="2" marker-end="url(#arrow-red)"></line>
        <polyline points="300,2160 500,2160 500,2290" stroke="var(--status-complete)" stroke-width="2" marker-end="url(#arrow-green)"></polyline>
        <line x1="500" y1="1892" x2="500" y2="2290" stroke="var(--status-complete)" stroke-width="2" marker-end="url(#arrow-green)"></line>

        <!-- ambiguous rows -->
        <line x1="630" y1="2340" x2="700" y2="2340" stroke="var(--status-complete)" stroke-width="2" marker-end="url(#arrow-green)"></line>
        <polyline points="850,2368 850,2470 500,2470" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></polyline>
        <line x1="500" y1="2390" x2="500" y2="2470" stroke="var(--status-failed)" stroke-width="2" marker-end="url(#arrow-red)"></line>

        <!-- supersedes -->
        <line x1="630" y1="2520" x2="700" y2="2520" stroke="var(--status-complete)" stroke-width="2" marker-end="url(#arrow-green)"></line>
        <polyline points="850,2548 850,2650 500,2650" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></polyline>
        <line x1="500" y1="2570" x2="500" y2="2650" stroke="var(--status-failed)" stroke-width="2" marker-end="url(#arrow-red)"></line>

        <!-- loop back -->
        <polyline points="680,2678 1040,2678 1040,872 630,872" stroke="var(--text-muted)" stroke-width="2" marker-end="url(#arrow)"></polyline>
      </g>

      <!-- ================= YES / NO / PASS / FAIL CHIPS ================= -->
      <g class="chip-yes"><rect x="483" y="277" width="34" height="18" rx="9"></rect><text x="500" y="290">YES</text></g>
      <g class="chip-no"><rect x="150" y="187" width="32" height="18" rx="9"></rect><text x="166" y="200">NO</text></g>
      <g class="chip-yes"><rect x="648" y="669" width="34" height="18" rx="9"></rect><text x="665" y="682">YES</text></g>
      <g class="chip-no"><rect x="319" y="853" width="32" height="18" rx="9"></rect><text x="335" y="866">NO</text></g>
      <g class="chip-yes"><rect x="483" y="953" width="34" height="18" rx="9"></rect><text x="500" y="966">YES</text></g>
      <g class="chip-no"><rect x="319" y="1169" width="32" height="18" rx="9"></rect><text x="335" y="1182">NO</text></g>
      <g class="chip-no"><rect x="184" y="1418" width="32" height="18" rx="9"></rect><text x="200" y="1431">NO</text></g>
      <g class="chip-yes"><rect x="383" y="1313" width="34" height="18" rx="9"></rect><text x="400" y="1326">YES</text></g>
      <g class="chip-yes"><rect x="497" y="1281" width="34" height="18" rx="9"></rect><text x="514" y="1294">YES</text></g>
      <g class="chip-no"><rect x="319" y="1643" width="32" height="18" rx="9"></rect><text x="335" y="1656">NO</text></g>
      <g class="chip-yes"><rect x="497" y="1743" width="34" height="18" rx="9"></rect><text x="514" y="1756">YES</text></g>
      <g class="chip-fail"><rect x="242" y="1819" width="36" height="18" rx="9"></rect><text x="260" y="1832">FAIL</text></g>
      <g class="chip-yes"><rect x="383" y="2137" width="34" height="18" rx="9"></rect><text x="400" y="2150">YES</text></g>
      <g class="chip-pass"><rect x="494" y="2081" width="40" height="18" rx="9"></rect><text x="514" y="2094">PASS</text></g>
      <g class="chip-yes"><rect x="648" y="2317" width="34" height="18" rx="9"></rect><text x="665" y="2330">YES</text></g>
      <g class="chip-no"><rect x="497" y="2421" width="32" height="18" rx="9"></rect><text x="514" y="2434">NO</text></g>
      <g class="chip-yes"><rect x="648" y="2497" width="34" height="18" rx="9"></rect><text x="665" y="2510">YES</text></g>
      <g class="chip-no"><rect x="497" y="2601" width="32" height="18" rx="9"></rect><text x="514" y="2614">NO</text></g>

      <text x="1030" y="1000" text-anchor="end" class="step-label">next item</text>
      <text x="700" y="1102" text-anchor="start" class="step-label">(process) — per claimed item, steps below</text>

      <!-- ================= START ================= -->
      <g filter="url(#glow)">
        <rect x="370" y="20" width="260" height="46" rx="23" fill="var(--surface)" stroke="var(--accent)" stroke-width="1.5"></rect>
        <text x="500" y="47" text-anchor="middle" class="a-text" fill="var(--accent)">6:00 AM — Scheduler rings</text>
      </g>

      <!-- ============ STEP: failed work? ============ -->
      <g filter="url(#glow)">
        <use href="#hexgate" transform="translate(500,196)" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="2"></use>
        <text x="500" y="190" text-anchor="middle" class="q-text">failed work from</text>
        <text x="500" y="208" text-anchor="middle" class="q-text">last time?</text>
      </g>

      <!-- ============ STEP: why did it fail? ============ -->
      <g filter="url(#glow)">
        <use href="#hexgate" transform="translate(500,376)" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="2"></use>
        <text x="500" y="370" text-anchor="middle" class="q-text">why did</text>
        <text x="500" y="388" text-anchor="middle" class="q-text">it fail?</text>
      </g>

      <!-- ============ heal / refetch / human row ============ -->
      <g filter="url(#glow)">
        <rect x="40" y="506" width="260" height="56" rx="10" fill="var(--surface)" stroke="var(--agent-healer)" stroke-width="1.5"></rect>
        <text x="170" y="528" text-anchor="middle" class="a-text">quota blip →</text>
        <text x="170" y="546" text-anchor="middle" class="a-text">requeue</text>
      </g>
      <text x="310" y="538" text-anchor="start" class="tag">(heal)</text>

      <g filter="url(#glow)">
        <rect x="310" y="506" width="380" height="56" rx="10" fill="var(--surface)" stroke="var(--agent-healer)" stroke-width="1.5"></rect>
        <text x="500" y="528" text-anchor="middle" class="a-text">bad file → re-download from CARB,</text>
        <text x="500" y="546" text-anchor="middle" class="a-text">requeue</text>
      </g>
      <text x="700" y="538" text-anchor="start" class="tag">(refetch)</text>

      <g filter="url(#glow)">
        <rect x="700" y="506" width="300" height="56" rx="10" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="1.5"></rect>
        <text x="850" y="528" text-anchor="middle" class="a-text">3rd strike → leave</text>
        <text x="850" y="546" text-anchor="middle" class="a-text">for a human</text>
      </g>

      <!-- ============ STEP: new EOs? ============ -->
      <g filter="url(#glow)">
        <use href="#hexgate" transform="translate(500,692)" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="2"></use>
        <text x="500" y="686" text-anchor="middle" class="q-text">new EOs in the</text>
        <text x="500" y="704" text-anchor="middle" class="q-text">state registry?</text>
      </g>

      <g filter="url(#glow)">
        <rect x="700" y="664" width="300" height="56" rx="10" fill="var(--surface)" stroke="var(--status-discovered)" stroke-width="1.5"></rect>
        <text x="850" y="686" text-anchor="middle" class="a-text">download PDFs,</text>
        <text x="850" y="704" text-anchor="middle" class="a-text">add to queue</text>
      </g>
      <text x="1010" y="694" text-anchor="start" class="tag">(scout)</text>

      <!-- ============ HUB: work in queue? time/budget left? ============ -->
      <g filter="url(#glow)">
        <use href="#hexgate" transform="translate(500,872)" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="2"></use>
        <text x="500" y="866" text-anchor="middle" class="q-text">work in queue?</text>
        <text x="500" y="884" text-anchor="middle" class="q-text">time &amp; budget left?</text>
      </g>

      <!-- ============ REST: sleep terminal ============ -->
      <g filter="url(#glow)">
        <rect x="40" y="837" width="260" height="70" rx="10" fill="var(--status-complete-bg)" stroke="var(--accent)" stroke-width="1.5"></rect>
        <text x="170" y="866" text-anchor="middle" class="a-text" fill="var(--accent)">write run summary —</text>
        <text x="170" y="884" text-anchor="middle" class="a-text" fill="var(--accent)">sleep until tomorrow</text>
      </g>
      <text x="170" y="922" text-anchor="middle" class="tag">(summarize)</text>

      <!-- ============ claim ============ -->
      <g filter="url(#glow)">
        <rect x="370" y="1002" width="260" height="56" rx="10" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="1.5"></rect>
        <text x="500" y="1034" text-anchor="middle" class="a-text">claim oldest item</text>
      </g>
      <text x="650" y="1034" text-anchor="start" class="tag">(claim)</text>

      <!-- ============ STEP: Gemini read PDF natively? ============ -->
      <g filter="url(#glow)">
        <use href="#hexgate" transform="translate(500,1188)" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="2"></use>
        <text x="500" y="1182" text-anchor="middle" class="q-text">can Gemini read the</text>
        <text x="500" y="1200" text-anchor="middle" class="q-text">PDF natively?</text>
      </g>

      <g filter="url(#glow)">
        <rect x="40" y="1160" width="260" height="56" rx="10" fill="var(--surface)" stroke="var(--status-matching)" stroke-width="1.5"></rect>
        <text x="170" y="1182" text-anchor="middle" class="a-text">re-render pages as</text>
        <text x="170" y="1200" text-anchor="middle" class="a-text">images, retry</text>
      </g>

      <g filter="url(#glow)">
        <use href="#hexgate" transform="translate(170,1346)" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="2"></use>
        <text x="170" y="1351" text-anchor="middle" class="q-text">readable now?</text>
      </g>

      <g filter="url(#glow)">
        <rect x="40" y="1476" width="260" height="70" rx="10" fill="var(--status-failed-bg)" stroke="var(--status-failed)" stroke-width="1.5"></rect>
        <text x="170" y="1505" text-anchor="middle" class="a-text">mark failed — tomorrow's</text>
        <text x="170" y="1523" text-anchor="middle" class="a-text">run decides</text>
      </g>

      <!-- ============ extraction ============ -->
      <g filter="url(#glow)">
        <rect x="320" y="1476" width="360" height="56" rx="10" fill="var(--surface)" stroke="var(--status-matching)" stroke-width="1.5"></rect>
        <text x="500" y="1508" text-anchor="middle" class="a-text">structured extraction (Gemini 3.7 Flash)</text>
      </g>

      <!-- ============ STEP: header EO matches identity? ============ -->
      <g filter="url(#glow)">
        <use href="#hexgate" transform="translate(500,1662)" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="2"></use>
        <text x="500" y="1656" text-anchor="middle" class="q-text">header EO number matches</text>
        <text x="500" y="1674" text-anchor="middle" class="q-text">the file's identity?</text>
      </g>

      <g filter="url(#glow)">
        <rect x="40" y="1634" width="260" height="56" rx="10" fill="var(--surface)" stroke="var(--border-strong)" stroke-width="1.5"></rect>
        <text x="170" y="1656" text-anchor="middle" class="a-text">trust the file,</text>
        <text x="170" y="1674" text-anchor="middle" class="a-text">log the misread</text>
      </g>

      <!-- ============ STEP: deterministic gate + critic ============ -->
      <g filter="url(#glow)">
        <use href="#hexgate" transform="translate(500,1842)" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="2"></use>
        <text x="500" y="1836" text-anchor="middle" class="q-text">deterministic gate:</text>
        <text x="500" y="1854" text-anchor="middle" class="q-text">rules + baseline</text>
      </g>
      <text x="650" y="1846" text-anchor="start" class="tag">(audit)</text>
      <text x="500" y="1905" text-anchor="middle" class="q-text-sm">(dates real · formats sane ·</text>
      <text x="500" y="1922" text-anchor="middle" class="q-text-sm">physics possible · vs. legacy)</text>

      <g filter="url(#glow)">
        <rect x="40" y="1974" width="260" height="56" rx="10" fill="var(--surface)" stroke="var(--status-matching)" stroke-width="1.5"></rect>
        <text x="170" y="1996" text-anchor="middle" class="a-text">critic re-reads the</text>
        <text x="170" y="2014" text-anchor="middle" class="a-text">document (Gemini)</text>
      </g>

      <g filter="url(#glow)">
        <use href="#hexgate" transform="translate(170,2160)" fill="var(--surface)" stroke="var(--status-needs_review)" stroke-width="2"></use>
        <text x="170" y="2165" text-anchor="middle" class="q-text">resolved?</text>
      </g>

      <g filter="url(#glow)">
